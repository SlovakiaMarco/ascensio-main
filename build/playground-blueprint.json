{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/themes.php?page=asc-setup",
  "preferredVersions": { "php": "8.2", "wp": "latest" },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": { "WP_DEBUG": true, "WP_DEBUG_LOG": true, "WP_DEBUG_DISPLAY": true, "SCRIPT_DEBUG": false }
    },
    { "step": "login" },
    {
      "step": "installPlugin",
      "pluginData": { "resource": "wordpress.org/plugins", "slug": "elementor" },
      "options": { "activate": true }
    },
    { "step": "activateTheme", "themeFolderName": "ascensio" }
  ]
}
